{
  "openapi": "3.1.1",
  "info": {
    "title": "Inventory.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:18183/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Inventory.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/stock": {
      "get": {
        "tags": [
          "Inventory.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/stock/{itemId}": {
      "get": {
        "tags": [
          "Inventory.Api"
        ],
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Inventory.Api"
    }
  ]
}